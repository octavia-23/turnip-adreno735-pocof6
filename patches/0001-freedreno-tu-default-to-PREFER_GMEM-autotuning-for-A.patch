From 2b0d0fbadb79e65c45aa7ffeca05856fa5fd455e Mon Sep 17 00:00:00 2001
From: Akshat Yadav <akshatyadav237@gmail.com>
Date: Wed, 21 Oct 2026 01:14:27 +0530
Subject: [PATCH 1/3] freedreno/tu: default to PREFER_GMEM autotuning for
 Adreno 735 on SM8635

---
 src/freedreno/vulkan/tu_autotune.cc | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/freedreno/vulkan/tu_autotune.cc b/src/freedreno/vulkan/tu_autotune.cc
index c7551c1..d62fa0e 100644
--- a/src/freedreno/vulkan/tu_autotune.cc
+++ b/src/freedreno/vulkan/tu_autotune.cc
@@ -273,7 +273,11 @@ tu_autotune::get_env_config()
    static std::once_flag once;
    static config_t at_config;
    std::call_once(once, [&] {
-      algorithm algo = algorithm::DEFAULT;
+      /* Snapdragon 8s Gen 3 (SM8635 / Adreno 735):
+       * Default to PREFER_GMEM to avoid DRAM bus choke on 4MB SLC
+       * and eliminate runtime performance counter sampling stutters.
+       */
+      algorithm algo = algorithm::PREFER_GMEM;
       const char *algo_str = os_get_option("TU_AUTOTUNE_ALGO");
       std::string_view algo_strv;
 
