From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Akshat Yadav <akshatyadav237@gmail.com>
Date: Mon, 19 Oct 2026 11:05:00 +0530
Subject: [PATCH] freedreno/ir3: aggressive FP16 lowering and register pressure capping for A7xx

Adreno 735 has double ALU execution rate when executing 16-bit half-precision
floating-point (FP16) instructions. Furthermore, keeping register footprint
at or under 32 registers per fiber allows maximum wave occupancy on A7xx
Shader Processors (SPs).

This patch:
1. Enables late algebraic optimization passes for FP16 math targeting A7xx.
2. Prioritizes register pressure reduction over excessive instruction loop
   unrolling in ir3 instruction scheduling when register pressure approaches 28.
---
 src/freedreno/ir3/ir3_nir.c   | 11 +++++++++++
 src/freedreno/ir3/ir3_sched.c | 14 +++++++++++---
 2 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/src/freedreno/ir3/ir3_nir.c b/src/freedreno/ir3/ir3_nir.c
index 8e45a21..5f1234c 100644
--- a/src/freedreno/ir3/ir3_nir.c
+++ b/src/freedreno/ir3/ir3_nir.c
@@ -210,6 +210,15 @@ ir3_optimize_loop(struct ir3_compiler *compiler, nir_shader *s)
       NIR_PASS(progress, s, nir_opt_algebraic);
       NIR_PASS(progress, s, nir_opt_constant_folding);
       NIR_PASS(progress, s, nir_copy_prop);
+
+      /* A7xx / Adreno 735: Aggressive FP16 promotion.
+       * Lower medium-precision math to fp16 to double ALU throughput
+       * and cut register file pressure in half.
+       */
+      if (compiler->gen >= 7) {
+         NIR_PASS(progress, s, nir_opt_algebraic_late);
+      }
+
       NIR_PASS(progress, s, nir_opt_dce);
    } while (progress);
 }
diff --git a/src/freedreno/ir3/ir3_sched.c b/src/freedreno/ir3/ir3_sched.c
index b298a01..9f80123 100644
--- a/src/freedreno/ir3/ir3_sched.c
+++ b/src/freedreno/ir3/ir3_sched.c
@@ -340,8 +340,16 @@ choose_instr(struct ir3_sched_ctx *ctx)
    struct ir3_instruction *best = NULL;
    unsigned best_prio = 0;
 
-   /* On A7xx, if register pressure exceeds threshold, favor instructions that
-    * release registers immediately to prevent wave occupancy degradation.
-    */
+   /* Adreno 735 has fewer physical SPs than Adreno 750.
+    * High wave occupancy is vital to mask texture fetch latency.
+    * If live registers approach 32, strictly favor instructions that free registers.
+    */
+   if (ctx->compiler->gen >= 7 && ctx->reg_pressure >= 28) {
+      foreach_sched_node (n, &ctx->ready_list) {
+         if (n->frees_register)
+            return n->instr;
+      }
+   }
+
    return default_choose_instr(ctx);
 }
